# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Server-side API key for OpenRouter LLM endpoints (https://openrouter.ai/api/v1/chat/completions)
OPENROUTER_API_KEY=""

# Optional custom model for OpenRouter (defaults to google/gemini-2.5-flash or deepseek/deepseek-chat)
OPENROUTER_MODEL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Weather API Key (e.g. OpenWeatherMap, WeatherAPI, or Open-Meteo works out of the box with zero-config)
VITE_WEATHER_API_KEY=""

# Firebase Configuration (Optional - Demo/Local persistence activates gracefully if empty)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Google Maps API Key (Optional - Fallback interactive vector weather map provided)
VITE_GOOGLE_MAPS_API_KEY=""

# WeatherGPT Admin Account Configuration (Backend only - never expose in VITE_*)
ADMIN_EMAIL="mdsameeralam3289@gmail.com"
